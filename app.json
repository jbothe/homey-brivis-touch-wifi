{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "au.com.brivis.touch",
  "version": "1.0.0",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "Brivis"
  },
  "description": {
    "en": "Control in the palm of your hand"
  },
  "category": [
    "climate"
  ],
  "brandColor": "#132A4D",
  "permissions": [],
  "images": {
    "small": "/assets/images/small.jpeg",
    "large": "/assets/images/large.jpeg"
  },
  "author": {
    "name": "John Bothe",
    "email": "jbothe@gmail.com"
  },
  "support": "https://github.com/jbothe/homey-brivis-touch-wifi/issues",
  "source": "https://github.com/jbothe/homey-brivis-touch-wifi",
  "contributors": {
    "developers": [
      {
        "name": "David Matthews"
      }
    ]
  },
  "flow": {
    "triggers": [
      {
        "id": "rt_operating_mode_changed",
        "title": {
          "en": "The operating mode changed"
        },
        "titleFormatted": {
          "en": "The operating mode changed to [[rt_operating_mode]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=zone"
          },
          {
            "name": "rt_operating_mode",
            "type": "dropdown",
            "title": {
              "en": "mode"
            },
            "values": [
              {
                "id": "heat",
                "title": {
                  "en": "Heat"
                }
              },
              {
                "id": "cool",
                "title": {
                  "en": "Cool"
                }
              },
              {
                "id": "evap",
                "title": {
                  "en": "Evaporative"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "rt_zone_active_changed",
        "title": {
          "en": "Actively heating/cooling changed"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=zone"
          }
        ],
        "tokens": [
          {
            "name": "rt_zone_active",
            "type": "boolean",
            "title": {
              "en": "Actively heating/cooling"
            }
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "rt_operating_mode_is",
        "title": {
          "en": "The operating mode !{{is|is not}}"
        },
        "titleFormatted": {
          "en": "The operating mode !{{is|is not}} [[rt_operating_mode]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=zone"
          },
          {
            "name": "rt_operating_mode",
            "type": "dropdown",
            "title": {
              "en": "mode"
            },
            "values": [
              {
                "id": "heat",
                "title": {
                  "en": "Heat"
                }
              },
              {
                "id": "cool",
                "title": {
                  "en": "Cool"
                }
              },
              {
                "id": "evap",
                "title": {
                  "en": "Evaporative"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "rt_zone_active_is",
        "title": {
          "en": "Zone !{{is|is not}} actively heating/cooling"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=zone"
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "rt_fan_speed_set",
        "title": {
          "en": "Set the fan speed to"
        },
        "titleFormatted": {
          "en": "Set the fan speed to [[rt_fan_speed]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=zone"
          },
          {
            "name": "rt_fan_speed",
            "type": "number",
            "title": {
              "en": "speed"
            },
            "min": 1,
            "max": 16,
            "step": 1
          }
        ]
      },
      {
        "id": "rt_operating_mode_set",
        "title": {
          "en": "Set the operating mode to"
        },
        "titleFormatted": {
          "en": "Set the operating mode to [[rt_operating_mode]]"
        },
        "args": [
          {
            "name": "device",
            "type": "device",
            "filter": "driver_id=zone"
          },
          {
            "name": "rt_operating_mode",
            "type": "dropdown",
            "title": {
              "en": "mode"
            },
            "values": [
              {
                "id": "heat",
                "title": {
                  "en": "Heat"
                }
              },
              {
                "id": "cool",
                "title": {
                  "en": "Cool"
                }
              },
              {
                "id": "evap",
                "title": {
                  "en": "Evaporative"
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "id": "zone",
      "name": {
        "en": "Touch Wi-Fi Zone"
      },
      "class": "thermostat",
      "capabilities": [
        "target_temperature",
        "measure_temperature",
        "rt_zone_active",
        "onoff",
        "rt_operating_mode",
        "onoff.fan",
        "rt_fan_speed",
        "onoff.pump"
      ],
      "capabilitiesOptions": {
        "target_temperature": {
          "min": 8,
          "max": 30,
          "step": 1,
          "decimals": 0
        },
        "onoff": {
          "title": {
            "en": "System Power"
          }
        },
        "onoff.fan": {
          "title": {
            "en": "Circulation Fan"
          }
        },
        "onoff.pump": {
          "title": {
            "en": "Evaporative Pump"
          }
        }
      },
      "platforms": [
        "local"
      ],
      "connectivity": [
        "lan"
      ],
      "images": {
        "small": "/drivers/zone/assets/images/small.png",
        "large": "/drivers/zone/assets/images/large.png",
        "xlarge": "/drivers/zone/assets/images/xlarge.png"
      },
      "pair": [
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ]
    }
  ],
  "capabilities": {
    "rt_fan_speed": {
      "type": "number",
      "title": {
        "en": "Fan speed"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "slider",
      "min": 1,
      "max": 16,
      "step": 1,
      "decimals": 0
    },
    "rt_operating_mode": {
      "type": "enum",
      "title": {
        "en": "Operating mode"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "picker",
      "values": [
        {
          "id": "heat",
          "title": {
            "en": "Heat"
          }
        },
        {
          "id": "cool",
          "title": {
            "en": "Cool"
          }
        },
        {
          "id": "evap",
          "title": {
            "en": "Evaporative"
          }
        }
      ]
    },
    "rt_zone_active": {
      "type": "boolean",
      "title": {
        "en": "Actively heating/cooling"
      },
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insightsTitleTrue": {
        "en": "Started actively heating/cooling"
      },
      "insightsTitleFalse": {
        "en": "Stopped actively heating/cooling"
      }
    }
  }
}