{
  "extends": "athom/homey-app",
  "ignorePatterns": [],
  "settings": {
    "import/resolver": {
      "node": {
        "extensions": [".js", ".mjs", ".json", ".ts"]
      }
    },
    "import/extensions": [".js", ".mjs", ".jsx", ".ts"]
  },
  "rules": {
    "import/extensions": ["error", "ignorePackages", { "js": "never", "mjs": "never", "jsx": "never", "ts": "never" }],
    "node/no-missing-import": ["error", { "allowModules": ["homey"], "tryExtensions": [".js", ".json", ".node", ".ts"] }]
  },
  "overrides": [
    {
      "files": [
        "lib/rinnai/RinnaiTouchUdp.js",
        "lib/rinnai/RinnaiTouchTcp.js",
        "lib/rinnai/RinnaiTouchRepository.js",
        "lib/rinnai/StateService.js",
        "lib/rinnai/RinnaiTouchService.js"
      ],
      "rules": {
        "indent": "off",
        "keyword-spacing": "off",
        "object-curly-spacing": "off",
        "no-trailing-spaces": "off",
        "comma-spacing": "off",
        "comma-dangle": "off",
        "brace-style": "off",
        "eol-last": "off",
        "semi": "off",
        "quotes": "off",
        "prefer-const": "off",
        "no-var": "off",
        "object-shorthand": "off",
        "lines-between-class-members": "off",
        "strict": "off",
        "import/order": "off",
        "no-plusplus": "off",
        "no-mixed-operators": "off",
        "no-tabs": "off",
        "no-multi-spaces": "off",
        "key-spacing": "off",
        "no-multiple-empty-lines": "off",
        "consistent-return": "off",
        "@typescript-eslint/no-this-alias": "off",
        "homey-app/global-timers": "off"
      }
    },
    {
      "files": ["test/**/*.ts"],
      "rules": {
        "@typescript-eslint/no-floating-promises": "off",
        "homey-app/global-timers": "off",
        "max-classes-per-file": "off"
      }
    }
  ]
}
