{
  "id": "zone",
  "name": {
    "en": "Touch Wi-Fi Zone"
  },
  "class": "thermostat",
  "capabilities": [
    "target_temperature",
    "measure_temperature",
    "rt_zone_active",
    "onoff",
    "rt_operating_mode",
    "onoff.fan",
    "rt_fan_speed",
    "onoff.pump"
  ],
  "capabilitiesOptions": {
    "target_temperature": {
      "min": 8,
      "max": 30,
      "step": 1,
      "decimals": 0
    },
    "onoff": {
      "title": {
        "en": "System Power"
      }
    },
    "onoff.fan": {
      "title": {
        "en": "Circulation Fan"
      }
    },
    "onoff.pump": {
      "title": {
        "en": "Evaporative Pump"
      }
    }
  },
  "platforms": [
    "local"
  ],
  "connectivity": [
    "lan"
  ],
  "images": {
    "small": "/drivers/zone/assets/images/small.png",
    "large": "/drivers/zone/assets/images/large.png",
    "xlarge": "/drivers/zone/assets/images/xlarge.png"
  },
  "pair": [
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ]
}
