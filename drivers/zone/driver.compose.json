{
  "id": "zone",
  "name": {
    "en": "Touch Wi-Fi Zone",
    "nl": "Touch Wi-Fi Zone",
    "fr": "Zone Touch Wi-Fi",
    "de": "Touch Wi-Fi Zone"
  },
  "class": "thermostat",
  "capabilities": [
    "target_temperature",
    "measure_temperature",
    "rt_zone_active",
    "rt_control_mode",
    "rt_schedule_override",
    "rt_schedule_period",
    "onoff",
    "rt_operating_mode",
    "onoff.fan",
    "rt_fan_speed",
    "onoff.pump"
  ],
  "capabilitiesOptions": {
    "target_temperature": {
      "min": 8,
      "max": 30,
      "step": 1,
      "decimals": 0
    },
    "onoff": {
      "title": {
        "en": "System Power",
        "nl": "Systeem aan/uit",
        "fr": "Système marche/arrêt",
        "de": "System Ein/Aus"
      }
    },
    "onoff.fan": {
      "title": {
        "en": "Circulation Fan",
        "nl": "Circulatieventilator",
        "fr": "Ventilateur de circulation",
        "de": "Umluftventilator"
      }
    },
    "onoff.pump": {
      "title": {
        "en": "Evaporative Pump",
        "nl": "Verdampingspomp",
        "fr": "Pompe évaporative",
        "de": "Verdunstungspumpe"
      }
    }
  },
  "platforms": [
    "local"
  ],
  "connectivity": [
    "lan"
  ],
  "images": {
    "small": "/drivers/zone/assets/images/small.png",
    "large": "/drivers/zone/assets/images/large.png",
    "xlarge": "/drivers/zone/assets/images/xlarge.png"
  },
  "pair": [
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ]
}
