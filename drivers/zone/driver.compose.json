{
  "id": "zone",
  "name": {
    "en": "Touch Wi-Fi Zone",
    "nl": "Touch Wi-Fi Zone",
    "fr": "Zone Touch Wi-Fi",
    "de": "Touch Wi-Fi Zone"
  },
  "class": "thermostat",
  "capabilities": [
    "target_temperature",
    "measure_temperature",
    "rt_zone_active",
    "rt_control_mode",
    "rt_schedule_override",
    "rt_schedule_period",
    "onoff",
    "thermostat_mode",
    "onoff.fan",
    "rt_fan_speed",
    "onoff.pump",
    "rt_evap_control",
    "rt_comfort_level",
    "rt_prewet"
  ],
  "capabilitiesOptions": {
    "target_temperature": {
      "min": 8,
      "max": 30,
      "step": 1,
      "decimals": 0
    },
    "onoff": {
      "title": {
        "en": "System Power",
        "nl": "Systeem aan/uit",
        "fr": "Système marche/arrêt",
        "de": "System Ein/Aus"
      },
      "uiState": true
    },
    "onoff.fan": {
      "title": {
        "en": "Circulation Fan",
        "nl": "Circulatieventilator",
        "fr": "Ventilateur de circulation",
        "de": "Umluftventilator"
      }
    },
    "onoff.pump": {
      "title": {
        "en": "Evaporative Pump",
        "nl": "Verdampingspomp",
        "fr": "Pompe évaporative",
        "de": "Verdunstungspumpe"
      }
    },
    "thermostat_mode": {
      "values": [
        {
          "id": "heat",
          "title": {
            "en": "Heat",
            "nl": "Verwarmen",
            "fr": "Chauffage",
            "de": "Heizen"
          }
        },
        {
          "id": "cool",
          "title": {
            "en": "Cool",
            "nl": "Koelen",
            "fr": "Refroidissement",
            "de": "Kühlen"
          }
        },
        {
          "id": "evap",
          "title": {
            "en": "Evaporative",
            "nl": "Verdampingskoeling",
            "fr": "Refroidissement évaporatif",
            "de": "Verdunstungskühlung"
          }
        },
        {
          "id": "off",
          "title": {
            "en": "Off",
            "nl": "Uit",
            "fr": "Arrêt",
            "de": "Aus"
          }
        }
      ]
    }
  },
  "platforms": [
    "local"
  ],
  "connectivity": [
    "lan"
  ],
  "images": {
    "small": "/drivers/zone/assets/images/small.png",
    "large": "/drivers/zone/assets/images/large.png",
    "xlarge": "/drivers/zone/assets/images/xlarge.png"
  },
  "pair": [
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ]
}
